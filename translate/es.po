#~ "configuración usando esto a continuación en la terminal/tty y luego "
#~ "reinicie:<br><strong><code>sed -i 's/^VideoUrls=.*$/VideoUrls=/g' $HOME/."
#~ "config/plasma-org.kde.plasma.desktop-appletsrc $HOME/.config/"
#~ "kscreenlockerrc</code></strong>"

